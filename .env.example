# =============================================================================
# Electorate (naijrep) — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
#
# NEVER commit .env.local — it is already in .gitignore.
# =============================================================================

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL & keys from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Personal access token (for migrations / schema management only, optional in prod)
# Get one at: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# ── Twilio Verify (phone OTP) ───────────────────────────────────────────────
# From: https://console.twilio.com
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Verify Service SID from: https://console.twilio.com/verify/services
TWILIO_VERIFY_SERVICE_SID=your-twilio-verify-service-sid

# ── App ──────────────────────────────────────────────────────────────────────
# The canonical public URL of the deployed app (no trailing slash).
# In development this is http://localhost:3000; in production set to your
# real domain, e.g. https://electorate.ng
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Electorate
